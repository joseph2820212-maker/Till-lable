{
  "name": "tilllabel",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC jest --passWithNoTests",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0"
  },
  "dependencies": {
    "@config-plugins/react-native-blob-util": "12.0.0",
    "@config-plugins/react-native-pdf": "12.0.0",
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo/vector-icons": "~15.1.1",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "~54.0.36",
    "expo-camera": "~17.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.0",
    "expo-localization": "~17.0.9",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.0",
    "expo-updates": "~29.0.19",
    "i18next": "^26.2.0",
    "react": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-blob-util": "^0.24.9",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-pdf": "^7.0.4",
    "react-native-purchases": "^10.4.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/@react-native-async-storage/async-storage.ts",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.ts",
      "^expo-file-system$": "<rootDir>/__mocks__/expo-file-system.ts",
      "^expo-file-system/legacy$": "<rootDir>/__mocks__/expo-file-system.ts",
      "^expo-print$": "<rootDir>/__mocks__/expo-print.ts",
      "^expo-sharing$": "<rootDir>/__mocks__/expo-sharing.ts",
      "^expo-localization$": "<rootDir>/__mocks__/expo-localization.ts",
      "^expo-updates$": "<rootDir>/__mocks__/expo-updates.ts",
      "^expo$": "<rootDir>/__mocks__/expo.ts",
      "^react-native$": "<rootDir>/__mocks__/react-native.ts",
      "^react-native-keyboard-controller$": "<rootDir>/__mocks__/react-native-keyboard-controller.tsx",
      "^react-native-purchases$": "<rootDir>/__mocks__/react-native-purchases.ts",
      "^react-native-reanimated$": "<rootDir>/__mocks__/react-native-reanimated.ts",
      "^react-native-pdf$": "<rootDir>/__mocks__/react-native-pdf.tsx",
      "^react-native-blob-util$": "<rootDir>/__mocks__/react-native-blob-util.ts",
      "^expo-camera$": "<rootDir>/__mocks__/expo-camera.tsx",
      "^expo-haptics$": "<rootDir>/__mocks__/expo-haptics.ts",
      "^expo-document-picker$": "<rootDir>/__mocks__/expo-document-picker.ts"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|@noble))",
      "/node_modules/react-native-reanimated/plugin/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ]
  },
  "private": true
}
