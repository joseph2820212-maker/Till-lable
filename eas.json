{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "distribution": "store"
      }
    },
    "review": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "review",
      "env": {
        "APP_VARIANT": "review",
        "EXPO_PUBLIC_BILLING_BYPASS": "1"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
