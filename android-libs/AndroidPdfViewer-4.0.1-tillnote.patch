+    private PagePart proceed(RenderingTask renderingTask) throws PageRenderingException {
+        if (!running) {
+            return null;
+        }
+        PdfFile pdfFile = pdfView.pdfFile;
+        if (pdfFile == null) {
+            return null;
+        }
+
+        try {
+            return render(pdfFile, renderingTask);
+        } catch (RuntimeException exception) {
+            // recycle() stops this handler before disposing PdfFile. A render that
+            // was already running can otherwise race into the closed document.
+            if (!running || pdfView.pdfFile != pdfFile) {
+                Log.d(TAG, "Dropped stale PDF rendering task after recycle");
+                return null;
+            }
+            throw exception;
+        }
+    }
